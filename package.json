{
  "name": "lifev24care-hospital",
  "version": "1.0.0",
  "private": true,
  "description": "LifeV 24 Care Hospital - React + Node website",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "install:all": "npm install",
    "images": "node scripts/generate-images.mjs",
    "photos": "node scripts/fetch-photos.mjs",
    "use-photos": "node scripts/use-photos.mjs",
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "optionalDependencies": {
    "sharp": "^0.35.4"
  }
}
