{
  "name": "lifev24care-hospital",
  "version": "1.0.0",
  "private": true,
  "description": "LifeV 24 Care Hospital - React + Node website",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "images": "node scripts/generate-images.mjs",
    "photos": "node scripts/fetch-photos.mjs",
    "use-photos": "node scripts/use-photos.mjs",
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "sharp": "^0.34.4"
  }
}
